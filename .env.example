# Copy this file to .env and adjust the values for your SQL Server installation.
# Uses Windows Integrated Authentication; no database password is stored here.
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=ABC_Retail_DB
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
